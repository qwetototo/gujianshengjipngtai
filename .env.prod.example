# Copy to .env on the server and set unique random secrets before deployment.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ROOT_SECRET
MYSQL_DATABASE=ota_console
MYSQL_USER=ota_app
MYSQL_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_DATABASE_SECRET
OTA_DATABASE_URL=jdbc:mysql://mysql:3306/ota_console?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=false&sslMode=REQUIRED
OTA_DATABASE_USERNAME=ota_app
OTA_DATABASE_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_DATABASE_SECRET
OTA_ADMIN_USERNAME=admin
OTA_ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_16_RANDOM_CHARACTERS
OTA_STORAGE_PATH=/goujian/ota/firmware
OTA_FIRMWARE_HISTORY_RETAIN_COUNT=5
OTA_STORAGE_WARNING_FREE_PERCENT=15
OTA_STORAGE_WARNING_FREE_BYTES=10737418240
OTA_STORAGE_UPLOAD_RESERVE_BYTES=2147483648
OTA_MAX_FILE_SIZE=200MB
OTA_MAX_REQUEST_SIZE=220MB
OTA_DATABASE_POOL_SIZE=10
HTTP_PORT=18082
